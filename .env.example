# 관리자 전체조회 키(비우면 관리자 기능 비활성)
PDF2MD_ADMIN_KEY=
# host 포트 (PORTS.md 규칙: NN=01)
PDF2MD_PORT=8001
# 진행률 추정용 초/페이지 (실측으로 보정). GPU에서는 CPU보다 훨씬 빨라지므로 낮춰 잡는다.
PDF2MD_SEC_PER_PAGE=1.5
# GPU 배치 크기 (CUDA일 때만 적용). VRAM 8GB(3060 Ti)는 4, 6GB(4050 랩탑 등)는 2.
# CUDA OOM이 나면 한 단계씩 낮춘다 — 재빌드 불필요, worker 재시작이면 된다.
PDF2MD_GPU_BATCH=4
# worker 컨테이너 RAM 천장 (GPU 오버레이에서만 적용). RAM 32GB면 12g, 16GB 랩탑이면 8g.
# 모델은 VRAM에 있어도 페이지 비트맵 파싱은 호스트 RAM이라 이 값이 OOM을 좌우한다.
PDF2MD_WORKER_MEM=12g
